# ─────────────────────────────────────────────
#  비밀값 — 절대 커밋하지 말 것
# ─────────────────────────────────────────────
키입력.txt
*.env
.env
.env.*
!.env.example
*secret*
*authtoken*

# ─────────────────────────────────────────────
#  모델 가중치
#  AI-Hub 데이터로 학습한 산출물이라 저장소에 넣지 않는다.
#  (상류 traffic-deploy 저장소도 같은 정책)
#  필요하면 이 블록을 지우고 models/ 를 커밋하면 된다.
# ─────────────────────────────────────────────
models/
*.pt
*.pth
*.onnx

# ─────────────────────────────────────────────
#  벤더링한 저장소 안의 런타임 산출물
#  (코드와 문서는 커밋하되, 실행하면서 생기는 것은 제외)
# ─────────────────────────────────────────────
traffic_project/data/
traffic_project/.venv/
traffic_project/models/weights/
traffic_project/frontend/dist/
traffic_project/frontend/node_modules/
**/__pycache__/
*.pyc

# ─────────────────────────────────────────────
#  런타임 · 임시
# ─────────────────────────────────────────────
data/
*.log
*.tgz
*.zip

# 셸 리다이렉션 사고로 생기는 파일 (pip install "x>=1.0" 을 PowerShell 에서 실행하면 생김)
=*

# ─────────────────────────────────────────────
#  OS · 편집기
# ─────────────────────────────────────────────
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
.vscode/
.idea/
*.swp
*~
