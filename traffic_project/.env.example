# ---- 복사해서 .env 로 저장한 뒤 값을 채우세요 ----

# 국가교통정보센터(ITS) CCTV Open API 인증키 (https://www.its.go.kr/opendata/opendataList?service=cctv)
ITS_API_KEY=

# PostgreSQL 연결 문자열 (SQLAlchemy + psycopg3)
# brew postgresql@17 을 5433 포트로 띄운 경우:
DATABASE_URL=postgresql+psycopg://localhost:5433/traffic
# 기존 PostgreSQL 18(5432, postgres 계정)을 쓰려면:
# DATABASE_URL=postgresql+psycopg://postgres:비밀번호@localhost:5432/traffic

# 모델 가중치
YOLO_WEIGHTS=models/weights/yolov8s_seg_vehicle.pt
SAM3_WEIGHTS=models/weights/sam3.pt          # 없으면 SAM2.1(models/weights/sam2.1_b.pt, 자동 다운로드)로 대체 — 텍스트 프롬프트 불가
DEVICE=auto                                   # auto | mps | cuda | cpu

# 추론 설정
YOLO_IMGSZ=960
YOLO_CONF=0.25
INFER_FPS=2.0                                 # '실시간' 모드의 카메라당 초당 추론 횟수
DEFAULT_INFER_INTERVAL_S=10                   # 새 카메라의 기본 추론 주기(초). 0 = 실시간
SAMPLE_WRITE_INTERVAL=5                       # DB 기록 간격(초)

# 혼잡 단계 임계값 (도로 대비 차량 면적비): 원활 < t1 <= 서행 < t2 <= 지체 < t3 <= 정체
CONGESTION_THRESHOLDS=0.08,0.15,0.25

# 서버
HOST=0.0.0.0
PORT=8000
# 프론트를 다른 도메인(Vercel 등)에 배포할 때 허용할 출처 (쉼표 구분). *.vercel.app 은 기본 허용.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
